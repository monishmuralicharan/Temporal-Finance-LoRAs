# Massive.com (formerly Polygon.io) credentials — copy to .env and fill in.
# Dashboard: https://massive.com/dashboard

# REST API (tab: "Accessing the API")
MASSIVE_API_KEY=your_api_key_here
# Seconds between REST calls (5/min plan → 12.5; unlimited/paid → 0.15)
MASSIVE_REQUEST_DELAY=0.15

# S3 flat files (tab: "Accessing Flat Files (S3)")
MASSIVE_S3_ACCESS_KEY_ID=your_access_key_id
MASSIVE_S3_SECRET_ACCESS_KEY=your_secret_access_key
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
